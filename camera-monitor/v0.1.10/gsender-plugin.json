{
  "id": "com.bakstaaj.camera-monitor",
  "name": "CNC Camera Monitor",
  "version": "0.1.10",
  "description": "View USB and network camera feeds in gSender while a CNC job is running.",
  "engine": "1.7.0-Edge-2",
  "permissions": ["camera", "media", "storage"],
  "ui": {
    "entry": "ui/index.html",
    "contributions": [
      { "slot": "tools-page", "route": "camera-monitor", "label": "CNC Camera Monitor" },
      { "slot": "tools-tab", "label": "Camera" }
    ]
  },
  "capabilities": {
    "requestTypes": ["storage:get", "storage:set"],
    "allowedFunctions": ["storage"]
  }
}
